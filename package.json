{
  "name": "code-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node server.js",
    "prepare": "vite build --config frontend/vite.config.ts",
    "install-browser": "playwright-core install chromium",
    "dev": "vite --config frontend/vite.config.ts",
    "typecheck": "tsc -p frontend",
    "test": "npm run test:server && npm run test:web",
    "test:server": "node --test \"tests/**/*.test.mjs\"",
    "test:web": "vitest run --config frontend/vitest.config.ts",
    "test:e2e": "node --test tests/e2e.real.test.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "playwright-core": "^1.64.1",
    "ws": "^8.22.0"
  }
}
