        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9\\-]{0,39}$",
              "maxLength": 40,
              "description": "Browser name (lowercase letters, digits, dashes). Defaults to \"default\". A new name starts with no logins or cookies."
            }
          }
        },
