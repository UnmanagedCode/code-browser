{
  "id": "code-browser",
  "name": "Code Browser",
  "version": "0.1.0",
  "pluginApi": 1,
  "backend": {
    "start": "node server.js",
    "healthPath": "/api/health"
  },
  "frontend": {
    "path": "/",
    "navLabel": "Code Browser"
  },
  "runCode": {
    "module": "src/runCode/index.js",
    "members": [
      {
        "name": "connect",
        "description": "Connect Playwright to a running shared browser and return {browser, context, page, info, save}: `page` is the tab to drive, `info` is browser_info's data, `save(bytes, ext)` is an async function that writes a Buffer (a screenshot, say) to the plugin's artifacts directory and resolves its path, and `browser.close()` only disconnects. Start the browser first with start_browser. Refused with BROWSER_CONTROLLED while a human has control. Usage: `const { page, save } = await cc.code_browser.connect({ name: \"default\" });`. Load the drive-browser skill for the full workflow.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9\\-]{0,39}$",
              "maxLength": 40,
              "description": "Browser name. Defaults to \"default\"."
            },
            "timeout": {
              "type": "integer",
              "minimum": 1,
              "description": "Milliseconds to wait for the connection. Defaults to 10000."
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "browser",
            "context",
            "page",
            "info"
          ],
          "properties": {
            "browser": {
              "type": "object",
              "additionalProperties": true,
              "description": "Playwright Browser connected through code-browser's CDP relay; close() only disconnects."
            },
            "context": {
              "type": "object",
              "additionalProperties": true,
              "description": "The browser's Playwright BrowserContext (its first)."
            },
            "page": {
              "type": "object",
              "additionalProperties": true,
              "description": "The Playwright Page to drive: the active tab, or the first one."
            },
            "info": {
              "type": "object",
              "additionalProperties": true,
              "description": "browser_info's data for this browser (tabs, controller, helper)."
            }
          },
          "description": "Also carries `save`, an async function (not expressible in this schema)."
        }
      }
    ]
  },
  "claudePlugin": "claude",
  "mcp": {
    "endpoint": "/api/mcp",
    "timeoutMs": 60000,
    "tools": [
      {
        "name": "list_browsers",
        "description": "List the shared browsers: name, kind (launched: a headless Chromium code-browser runs; attached: the user's own browser, which a human attached in the panel), status (running|stopped, or connecting for an attached one), who controls it (agent|human), the CDP endpoint while running, the read-only allowUnsandboxed (whether a human allowed it to run without the sandbox), and for an attached browser `attached` (its debug address, how it is reached, and whether Chrome asks the user to approve each connection).",
        "inputSchema": {
          "type": "object",
          "properties": {}
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "browsers"
          ],
          "properties": {
            "browsers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "kind",
                  "controller",
                  "status",
                  "cdpEndpoint",
                  "sandbox",
                  "allowUnsandboxed",
                  "sandboxUnavailable",
                  "lastExit",
                  "attached",
                  "attachError"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "launched",
                      "attached"
                    ]
                  },
                  "controller": {
                    "type": "string",
                    "enum": [
                      "agent",
                      "human"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "running",
                      "stopped",
                      "connecting"
                    ]
                  },
                  "cdpEndpoint": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "CDP endpoint while running (http://127.0.0.1:<port>, or the ws URL Chrome reports in approval mode); null otherwise"
                  },
                  "sandbox": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "false: running without Chromium's sandbox, do not browse untrusted pages; null when stopped or attached"
                  },
                  "allowUnsandboxed": {
                    "type": "boolean",
                    "description": "read-only: a human allowed it to run without the sandbox"
                  },
                  "sandboxUnavailable": {
                    "type": "boolean",
                    "description": "its last start was refused with SANDBOX_UNAVAILABLE"
                  },
                  "lastExit": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                      "code",
                      "signal",
                      "at"
                    ],
                    "properties": {
                      "code": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "signal": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "at": {
                        "type": "integer"
                      }
                    }
                  },
                  "attached": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                      "address",
                      "via",
                      "asksApproval"
                    ],
                    "properties": {
                      "address": {
                        "type": "string"
                      },
                      "via": {
                        "type": "string",
                        "enum": [
                          "proxy",
                          "direct"
                        ]
                      },
                      "asksApproval": {
                        "type": [
                          "boolean",
                          "null"
                        ],
                        "description": "true: Chrome asks the user to allow every connection; null until known"
                      }
                    }
                  },
                  "attachError": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "the last connect failure of an attached browser"
                  }
                }
              }
            }
          }
        }
      },
