              "type": "object",
              "additionalProperties": false,
              "required": [
                "module",
                "relay",
                "artifacts",
                "tokenFile",
                "artifactsDir"
              ],
              "description": "for the run_code helper; you only need `module`",
              "properties": {
                "module": {
                  "type": "string",
                  "description": "file URL of the helper: `(await import(module)).default({ cc }).connect({ name })` where cc.code_browser.connect is unavailable"
                },
                "relay": {
                  "type": "string"
                },
                "artifacts": {
                  "type": "string"
                },
                "tokenFile": {
